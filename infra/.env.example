# ---------------------------------------------------------------------------
# Terraform environment for the FastAPI boilerplate GCP stack.
#
# Copy to `.env` and fill in real values, then run ./tf.sh init/plan/apply.
# Every TF_VAR_* below maps 1:1 to a variable in envs/prod/variables.tf.
# `set -a; . ./.env; set +a` (done by tf.sh) exports them so Terraform
# picks them up automatically. NEVER commit your filled-in .env.
#
# Lines that are commented out have a sensible default in variables.tf;
# uncomment only to override. Lines that are NOT commented out have no
# default — you MUST set them.
# ---------------------------------------------------------------------------

# --- Terraform state backend (consumed by tf.sh, not by Terraform vars) ---
TF_STATE_BUCKET=
TF_STATE_PREFIX=prod

# --- Project / location ---
TF_VAR_project_id=
TF_VAR_region=
TF_VAR_zone=

# --- Network ---
# TF_VAR_vpc_name=app-vpc
# TF_VAR_subnet_name=app-primary
TF_VAR_subnet_cidr=
# TF_VAR_egress_subnet_name=app-egress
TF_VAR_egress_subnet_cidr=
# TF_VAR_psa_range_name=app-psa-range
# TF_VAR_psa_prefix_length=16
# TF_VAR_deny_all_egress_name=app-deny-all-egress
# TF_VAR_allow_egress_psa_name=app-allow-egress-psa
# TF_VAR_db_port=5432
# TF_VAR_redis_port=6379

# --- Cloud SQL (PostgreSQL) ---
# TF_VAR_sql_instance_name=app-postgres
# TF_VAR_sql_database_version=POSTGRES_16
# TF_VAR_sql_tier=db-g1-small
# TF_VAR_sql_edition=ENTERPRISE
# TF_VAR_sql_disk_size=10
# TF_VAR_sql_disk_type=PD_SSD
# TF_VAR_sql_availability_type=ZONAL
# TF_VAR_sql_ssl_mode=ENCRYPTED_ONLY
# TF_VAR_sql_deletion_protection=true
# TF_VAR_db_name=app
# TF_VAR_db_user=app
TF_VAR_db_password=

# --- Memorystore (Redis) ---
# TF_VAR_redis_instance_name=app-redis
# TF_VAR_redis_tier=BASIC
# TF_VAR_redis_memory_size_gb=1
# TF_VAR_redis_version=REDIS_7_2
# TF_VAR_redis_auth_enabled=true
# TF_VAR_redis_transit_encryption_mode=SERVER_AUTHENTICATION

# --- Secrets (Secret Manager containers; values added out-of-band) ---
# JSON list of secret IDs to create.
TF_VAR_secret_names=["app-db-password","app-secret-key"]

# --- IAM ---
# TF_VAR_runtime_sa_account_id=app-runtime
# TF_VAR_cicd_sa_account_id=app-cicd
# JSON list of GCS bucket names the runtime SA may read/write objects on.
# TF_VAR_runtime_bucket_names=[]

# --- Artifact Registry ---
# TF_VAR_ar_repo_name=app
# TF_VAR_ar_keep_recent_count=10
# TF_VAR_ar_delete_untagged_older_than_days=30

# --- Container image ---
# TF_VAR_image_name=app
# TF_VAR_image_tag=latest

# --- Cloud Run: API service ---
# TF_VAR_api_service_name=app-api
# JSON list, e.g. ["/app/start.sh"]
# TF_VAR_api_command=[]
# TF_VAR_api_ingress=INGRESS_TRAFFIC_INTERNAL_LOAD_BALANCER
# TF_VAR_api_min_instances=1
# TF_VAR_api_max_instances=10
# TF_VAR_api_cpu=1
# TF_VAR_api_memory=1Gi
# TF_VAR_api_startup_probe_path=/health
# TF_VAR_api_liveness_probe_path=/health

# --- Cloud Run: worker service ---
# TF_VAR_worker_service_name=app-worker
# TF_VAR_worker_command=[]
# TF_VAR_worker_min_instances=1
# TF_VAR_worker_max_instances=3
# TF_VAR_worker_cpu=1
# TF_VAR_worker_memory=1Gi

# --- Cloud Run: beat service ---
# TF_VAR_beat_service_name=app-beat
# TF_VAR_beat_command=[]
# TF_VAR_beat_min_instances=1
# TF_VAR_beat_max_instances=1
# TF_VAR_beat_cpu=1
# TF_VAR_beat_memory=512Mi

# --- Cloud Run: migrate job ---
# TF_VAR_migrate_job_name=app-migrate
# TF_VAR_migrate_command=[]
# TF_VAR_migrate_cpu=1
# TF_VAR_migrate_memory=512Mi

# --- Shared Cloud Run runtime config ---
# TF_VAR_container_port=8000
# TF_VAR_vpc_egress=PRIVATE_RANGES_ONLY
# JSON map of plain env vars, e.g. {"ENVIRONMENT":"production","LOG_FORMAT":"json"}
# TF_VAR_runtime_env={}
# JSON map of secret-backed env vars, e.g. {"DB_PASSWORD":{"secret":"app-db-password"}}
# TF_VAR_runtime_secret_env={}

# --- Cloud Build ---
# TF_VAR_cloud_build_trigger_name=app-deploy
# TF_VAR_cloud_build_region=global
TF_VAR_github_owner=
TF_VAR_github_repo=
# TF_VAR_github_branch_regex=^main$
# TF_VAR_cloud_build_config_filename=cloudbuild.yaml
# JSON map of build substitutions, e.g. {"_REGION":"us-central1"}
# TF_VAR_cloud_build_substitutions={}

# --- Load balancer ---
# TF_VAR_lb_name_prefix=app
TF_VAR_domain=
# TF_VAR_lb_enable_cdn=false
